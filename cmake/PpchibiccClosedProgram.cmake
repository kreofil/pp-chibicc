include_guard(GLOBAL)
include(CMakeParseArguments)
set(_PPCHIBICC_CLOSED_MODULE_DIR "${CMAKE_CURRENT_LIST_DIR}")

# Standard executable/object-library targets keep CMake's compile, dependency,
# incremental-build and CTest behavior. Only the compiler artifact mode changes.
function(ppchibicc_enable_closed_program target)
  if(NOT TARGET "${target}")
    message(FATAL_ERROR "Closed program target does not exist: ${target}")
  endif()
  cmake_parse_arguments(CLOSED "" "REPORT;OPTIMIZATION" "FAMILIES" ${ARGN})
  if(CLOSED_UNPARSED_ARGUMENTS OR CLOSED_KEYWORDS_MISSING_VALUES)
    message(FATAL_ERROR "Invalid closed-program options for ${target}")
  endif()
  get_target_property(kind "${target}" TYPE)
  get_target_property(imported "${target}" IMPORTED)
  if(imported OR NOT kind MATCHES "^(EXECUTABLE|OBJECT_LIBRARY)$")
    message(FATAL_ERROR "Closed programs support executable and OBJECT library targets: ${target}")
  endif()
  get_property(checked GLOBAL PROPERTY PPCHIBICC_CLOSED_COMPILER_CHECKED)
  if(NOT checked)
    execute_process(COMMAND "${CMAKE_C_COMPILER}" --help RESULT_VARIABLE status
      OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
    if(NOT status EQUAL 0 OR NOT "${stdout}${stderr}" MATCHES "--closed-program")
      message(FATAL_ERROR "Set CMAKE_C_COMPILER to ppchibicc with --closed-program support before project()")
    endif()
    set_property(GLOBAL PROPERTY PPCHIBICC_CLOSED_COMPILER_CHECKED TRUE)
  endif()
  target_compile_options("${target}" PRIVATE --closed-program)
  if(kind STREQUAL "OBJECT_LIBRARY")
    if(CLOSED_FAMILIES OR CLOSED_REPORT OR DEFINED CLOSED_OPTIMIZATION)
      message(FATAL_ERROR "Families, report and optimization belong to the final executable: ${target}")
    endif()
    return()
  endif()
  target_link_options("${target}" PRIVATE --closed-program)
  if(DEFINED CLOSED_OPTIMIZATION)
    if(NOT CLOSED_OPTIMIZATION MATCHES "^[0123sz]$")
      message(FATAL_ERROR "Closed optimization must be 0, 1, 2, 3, s or z")
    endif()
    target_link_options("${target}" PRIVATE "-O${CLOSED_OPTIMIZATION}")
  endif()
  foreach(family IN LISTS CLOSED_FAMILIES)
    target_link_options("${target}" PRIVATE "--closed-family=${family}")
  endforeach()
  if(CLOSED_REPORT)
    get_filename_component(report "${CLOSED_REPORT}" ABSOLUTE BASE_DIR "${CMAKE_CURRENT_BINARY_DIR}")
    target_link_options("${target}" PRIVATE "--closed-report=${report}")
  else()
    set(report "$<TARGET_FILE:${target}>.closed.json")
  endif()
  set_property(TARGET "${target}" PROPERTY PPCHIBICC_CLOSED_REPORT "${report}")
  set_property(TARGET "${target}" APPEND PROPERTY ADDITIONAL_CLEAN_FILES "${report}")
  set_property(TARGET "${target}" APPEND PROPERTY LINK_DEPENDS
    "${_PPCHIBICC_CLOSED_MODULE_DIR}/ppc-static-dispatch.py"
    "${_PPCHIBICC_CLOSED_MODULE_DIR}/ppc-dispatch-report.py"
    "${_PPCHIBICC_CLOSED_MODULE_DIR}/PpchibiccClosedProgram.cmake")
endfunction()
